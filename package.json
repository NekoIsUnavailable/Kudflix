{
  "name": "kudflix",
  "private": true,
  "version": "1.4.11",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "setup-mpv": "node scripts/download-mpv.cjs",
    "start": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "prepackage": "node scripts/check-mpv.cjs",
    "package": "npm run build && electron-builder -w -c.mac.identity=null"
  },
  "build": {
    "appId": "com.kudflix.app",
    "productName": "Kudflix",
    "directories": {
      "output": "../release_kudflix"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kudflix"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!electron/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "icons",
        "filter": [
          "icon.png"
        ]
      },
      {
        "from": "electron/bin/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "chokidar": "^5.0.0",
    "discord-rpc": "^4.0.1",
    "framer-motion": "^13.1.1",
    "jimp": "^0.16.13",
    "koffi": "^3.3.3",
    "lucide-react": "^1.34.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
